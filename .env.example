# Скопируй этот файл в .env.local и заполни своими значениями (для локальной разработки).
# На Vercel эти же переменные нужно будет вписать в Project Settings → Environment Variables.

# Токен бота из @BotFather
TELEGRAM_BOT_TOKEN=

# Chat ID владельца/бариста, куда будут приходить заказы (из @userinfobot)
TELEGRAM_CHAT_ID=

# Номер WhatsApp кофейни в международном формате, без + и пробелов
NEXT_PUBLIC_WHATSAPP_NUMBER=
